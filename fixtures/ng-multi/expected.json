{
  "$comment": "Oráculo de lo que ao scan debe detectar en este fixture. Formato informal hasta congelar el esquema de index.json (3.1); los detectores de M4 lo usan como referencia. Rutas relativas al fixture, en POSIX. Los usos cuentan elementos en templates (conteos sacados con grep; ver nota de M4 en TASKS.md).",
  "stack": {
    "angularVersion": "20",
    "workspace": "angular-cli",
    "projectStructure": "mixed",
    "uiLibraries": [],
    "styles": "css",
    "aliases": {
      "@acme/ui": {
        "paths": "./dist/acme-ui",
        "resolvesTo": "projects/acme-ui/src/public-api.ts",
        "via": "projects/acme-ui/ng-package.json (dest ../../dist/acme-ui, lib.entryFile src/public-api.ts)",
        "$comment": "dist/ no existe: el escáner resuelve el alias con el dest de ng-package.json, sin depender de un build"
      }
    }
  },
  "projects": [
    {
      "name": "portal",
      "type": "application",
      "root": "projects/portal",
      "sourceRoot": "projects/portal/src",
      "prefix": "app",
      "builder": "@angular/build:application",
      "bootstrap": "bootstrapApplication",
      "projectStructure": "standalone",
      "consumes": ["@acme/ui"]
    },
    {
      "name": "backoffice",
      "type": "application",
      "root": "projects/backoffice",
      "sourceRoot": "projects/backoffice/src",
      "prefix": "bo",
      "builder": "@angular/build:application",
      "bootstrap": "bootstrapModule",
      "projectStructure": "ngmodule",
      "consumes": ["@acme/ui"]
    },
    {
      "name": "acme-ui",
      "type": "library",
      "root": "projects/acme-ui",
      "sourceRoot": "projects/acme-ui/src",
      "prefix": "ui",
      "builder": "@angular/build:ng-packagr",
      "packageName": "@acme/ui",
      "entryFile": "projects/acme-ui/src/public-api.ts",
      "projectStructure": "standalone"
    }
  ],
  "sharedScopes": [
    {
      "scope": "workspace",
      "source": "projects/acme-ui/src/lib/",
      "project": "acme-ui",
      "$comment": "compartido entre proyectos: se consume por el alias @acme/ui"
    },
    {
      "scope": "project",
      "source": "projects/portal/src/app/shared/",
      "project": "portal",
      "$comment": "compartido solo dentro de portal"
    },
    {
      "scope": "project",
      "source": "projects/backoffice/src/app/shared/",
      "project": "backoffice",
      "$comment": "compartido solo dentro de backoffice (vía SharedModule)"
    }
  ],
  "library": {
    "name": "acme-ui",
    "exported": [
      { "selector": "ui-button", "class": "Button", "source": "projects/acme-ui/src/lib/button/" },
      { "selector": "ui-card", "class": "Card", "source": "projects/acme-ui/src/lib/card/" },
      { "selector": "ui-badge", "class": "Badge", "source": "projects/acme-ui/src/lib/badge/" }
    ],
    "internal": [
      {
        "selector": "ui-spinner",
        "class": "Spinner",
        "source": "projects/acme-ui/src/lib/spinner/",
        "usedBy": ["ui-button"],
        "$comment": "no está en public-api.ts: no se ofrece en el catálogo de las apps"
      }
    ]
  },
  "components": [
    { "selector": "ui-button", "project": "acme-ui", "scope": "workspace", "inputs": ["variant", "type", "disabled", "loading"], "outputs": ["clicked"] },
    { "selector": "ui-card", "project": "acme-ui", "scope": "workspace", "inputs": ["title", "elevated"], "slots": ["default", "[uiCardFooter]"] },
    { "selector": "ui-badge", "project": "acme-ui", "scope": "workspace", "inputs": ["tone"] },
    { "selector": "ui-spinner", "project": "acme-ui", "scope": "internal", "inputs": ["size"] },
    { "selector": "app-button", "project": "portal", "scope": "project", "inputs": ["variant", "disabled", "loading"], "outputs": ["clicked"] },
    { "selector": "bo-card", "project": "backoffice", "scope": "project", "inputs": ["titulo", "elevada"], "slots": ["default", "[boCardPie]"] },
    { "selector": "bo-button-group", "project": "backoffice", "scope": "project", "inputs": ["opciones", "seleccion"], "outputs": ["seleccionChange"] }
  ],
  "usages": {
    "ui-button": {
      "total": 3,
      "byProject": { "portal": 1, "backoffice": 2 },
      "files": [
        "projects/backoffice/src/app/features/usuarios/usuarios-lista/usuarios-lista.component.html",
        "projects/portal/src/app/pages/inicio/inicio.component.html"
      ]
    },
    "ui-card": {
      "total": 3,
      "byProject": { "portal": 3, "backoffice": 0 },
      "files": [
        "projects/portal/src/app/pages/catalogo/catalogo.component.html",
        "projects/portal/src/app/pages/inicio/inicio.component.html"
      ]
    },
    "ui-badge": { "total": 0, "byProject": { "portal": 0, "backoffice": 0 }, "files": [] },
    "ui-spinner": {
      "total": 1,
      "byProject": { "acme-ui": 1 },
      "files": ["projects/acme-ui/src/lib/button/button.html"]
    },
    "app-button": {
      "total": 2,
      "byProject": { "portal": 2 },
      "files": ["projects/portal/src/app/pages/catalogo/catalogo.component.html"]
    },
    "bo-card": {
      "total": 2,
      "byProject": { "backoffice": 2 },
      "files": ["projects/backoffice/src/app/features/usuarios/usuarios-lista/usuarios-lista.component.html"]
    },
    "bo-button-group": {
      "total": 1,
      "byProject": { "backoffice": 1 },
      "files": ["projects/backoffice/src/app/features/usuarios/usuarios-lista/usuarios-lista.component.html"]
    }
  },
  "duplicateCriterion": {
    "$comment": "Ver 4.12 en TASKS.md",
    "requires": "mismo nombre base del selector sin prefijo",
    "andAnyOf": ["comparten >= 2 inputs (por nombre)", "estructura de template equivalente (mismo árbol de elementos y slots ng-content; se ignoran clases, bindings y valores de select)"]
  },
  "duplicates": [
    {
      "a": { "selector": "app-button", "project": "portal", "source": "projects/portal/src/app/shared/button/" },
      "b": { "selector": "ui-button", "project": "acme-ui", "source": "projects/acme-ui/src/lib/button/" },
      "baseName": "button",
      "criteria": {
        "sharedInputs": { "met": true, "inputs": ["disabled", "loading", "variant"] },
        "equivalentTemplate": { "met": false, "$comment": "button > (span | ui-spinner condicional) + ng-content: el hijo condicional difiere" }
      },
      "suggest": "ui-button"
    },
    {
      "a": { "selector": "bo-card", "project": "backoffice", "source": "projects/backoffice/src/app/shared/card/" },
      "b": { "selector": "ui-card", "project": "acme-ui", "source": "projects/acme-ui/src/lib/card/" },
      "baseName": "card",
      "criteria": {
        "sharedInputs": { "met": false, "inputs": [], "$comment": "titulo/elevada frente a title/elevated: mismos conceptos, distinto nombre" },
        "equivalentTemplate": { "met": true, "tree": "section > [header > h3]? , div > ng-content , footer > ng-content[select]" }
      },
      "suggest": "ui-card"
    }
  ],
  "notDuplicates": [
    {
      "selector": "bo-button-group",
      "project": "backoffice",
      "comparedWith": "ui-button",
      "reason": "nombre base 'button-group' ≠ 'button' (no basta con contener el nombre); además no comparte inputs (opciones, seleccion) y su template es un grupo de botones (div > button*ngFor)"
    }
  ],
  "warnings": [
    {
      "type": "duplicate",
      "message": "app-button (portal/shared) duplica ui-button de @acme/ui: comparte 3 inputs (disabled, loading, variant)",
      "criterion": "sharedInputs",
      "files": ["projects/portal/src/app/shared/button/button.component.ts", "projects/acme-ui/src/lib/button/button.ts"]
    },
    {
      "type": "duplicate",
      "message": "bo-card (backoffice/shared) duplica ui-card de @acme/ui: template equivalente",
      "criterion": "equivalentTemplate",
      "files": ["projects/backoffice/src/app/shared/card/card.component.ts", "projects/acme-ui/src/lib/card/card.ts"]
    },
    {
      "type": "unused-export",
      "message": "ui-badge se exporta en public-api.ts de @acme/ui pero ningún proyecto lo usa",
      "files": ["projects/acme-ui/src/public-api.ts"]
    }
  ],
  "ngModules": [
    {
      "name": "SharedModule",
      "project": "backoffice",
      "source": "projects/backoffice/src/app/shared/shared.module.ts",
      "declarations": ["CardComponent", "ButtonGroupComponent"],
      "imports": ["CommonModule", "Button"],
      "exports": ["CommonModule", "Button", "CardComponent", "ButtonGroupComponent"],
      "$comment": "Button es standalone de @acme/ui, importado y re-exportado por un NgModule"
    },
    {
      "name": "UsuariosModule",
      "project": "backoffice",
      "source": "projects/backoffice/src/app/features/usuarios/usuarios.module.ts",
      "declarations": ["UsuariosListaComponent"],
      "imports": ["SharedModule", "UsuariosRoutingModule"],
      "visibleInTemplates": { "components": ["bo-button-group", "bo-card", "ui-button"] },
      "notVisible": ["ui-badge", "ui-card", "ui-spinner"]
    }
  ],
  "conventions": {
    "$comment": "Por proyecto: promediar todo el workspace mezclaría tres estilos distintos",
    "acme-ui": {
      "standalone": { "standalone": 4, "total": 4, "explicitFlag": 0, "$comment": "implícito (default desde v19)" },
      "inputs": { "decorator": 0, "signal": 8, "majority": "signal" },
      "outputs": { "decorator": 0, "signal": 1 },
      "di": { "constructor": 0, "inject": 0 },
      "controlFlow": { "structuralDirectives": 0, "blocks": 2, "majority": "blocks" },
      "fileNaming": "kebab-case.ts sin sufijo (button.ts, clase Button)"
    },
    "portal": {
      "standalone": { "standalone": 4, "total": 4, "explicitFlag": 4, "$comment": "standalone: true explícito aunque es el default en v20" },
      "inputs": { "decorator": 3, "signal": 0, "majority": "decorator" },
      "outputs": { "decorator": 1, "signal": 0 },
      "di": { "constructor": 3, "inject": 0, "majority": "constructor" },
      "controlFlow": { "structuralDirectives": 4, "blocks": 0, "majority": "structuralDirectives" },
      "fileNaming": "kebab-case.component.ts"
    },
    "backoffice": {
      "standalone": { "standalone": 0, "total": 4, "explicitFlag": 4, "$comment": "standalone: false obligatorio en v19+ para declarar en NgModule" },
      "inputs": { "decorator": 4, "signal": 0, "majority": "decorator" },
      "outputs": { "decorator": 1, "signal": 0 },
      "di": { "constructor": 2, "inject": 0, "majority": "constructor" },
      "controlFlow": { "structuralDirectives": 4, "blocks": 0, "majority": "structuralDirectives" },
      "ngModules": 5,
      "fileNaming": "kebab-case.component.ts / .module.ts"
    }
  },
  "routes": {
    "portal": [
      { "path": "", "redirectTo": "inicio" },
      { "path": "inicio", "loadComponent": "projects/portal/src/app/pages/inicio/inicio.component.ts#InicioComponent" },
      { "path": "catalogo", "loadComponent": "projects/portal/src/app/pages/catalogo/catalogo.component.ts#CatalogoComponent" },
      { "path": "**", "redirectTo": "inicio" }
    ],
    "backoffice": [
      { "path": "", "redirectTo": "usuarios" },
      {
        "path": "usuarios",
        "loadChildren": "projects/backoffice/src/app/features/usuarios/usuarios.module.ts#UsuariosModule",
        "children": [{ "path": "", "component": "UsuariosListaComponent" }]
      },
      { "path": "**", "redirectTo": "usuarios" }
    ]
  }
}

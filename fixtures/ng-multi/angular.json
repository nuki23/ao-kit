{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "portal": {
      "projectType": "application",
      "root": "projects/portal",
      "sourceRoot": "projects/portal/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/portal",
            "browser": "projects/portal/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/portal/tsconfig.app.json",
            "styles": ["projects/portal/src/styles.css"]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "portal:build"
          }
        }
      }
    },
    "backoffice": {
      "projectType": "application",
      "root": "projects/backoffice",
      "sourceRoot": "projects/backoffice/src",
      "prefix": "bo",
      "schematics": {
        "@schematics/angular:component": {
          "standalone": false
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/backoffice",
            "browser": "projects/backoffice/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/backoffice/tsconfig.app.json",
            "styles": ["projects/backoffice/src/styles.css"]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "backoffice:build"
          }
        }
      }
    },
    "acme-ui": {
      "projectType": "library",
      "root": "projects/acme-ui",
      "sourceRoot": "projects/acme-ui/src",
      "prefix": "ui",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/acme-ui/ng-package.json",
            "tsConfig": "projects/acme-ui/tsconfig.lib.json"
          }
        }
      }
    }
  }
}
